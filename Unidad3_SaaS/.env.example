# Configuración de FastAPI SaaS Microservice
PORT=8000
HOST=0.0.0.0
APP_ENV=dev
DEBUG=true

# Base de datos PostgreSQL compartida (Multi-Catálogo)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=multicatalogo

# Redis compartido
REDIS_HOST=localhost
REDIS_PORT=6379

# Secreto JWT compartido con Go/Fiber
JWT_SECRET=multicatalogo-super-secret-jwt-key
